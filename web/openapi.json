        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "HealthOut": {
        "properties": {
          "app": {
            "title": "App",
            "type": "string"
          }
        },
        "required": [
          "app"
        ],
        "title": "HealthOut",
        "type": "object"
      },
      "Money": {
        "properties": {
          "currency": {
            "title": "Currency",
            "type": "string"
          },
          "minor": {
            "title": "Minor",
            "type": "integer"
          }
        },
        "required": [
          "minor",
          "currency"
        ],
        "title": "Money",
        "type": "object"
      },
      "MonthTotalsOut": {
        "properties": {
          "currency": {
            "title": "Currency",
            "type": "string"
          },
          "money_in": {
            "$ref": "#/components/schemas/Money"
          },
          "money_out": {
            "$ref": "#/components/schemas/Money"
          },
          "month": {
            "title": "Month",
            "type": "string"
          }
        },
        "required": [
          "month",
          "currency",
          "money_in",
          "money_out"
        ],
        "title": "MonthTotalsOut",
        "type": "object"
      },
      "SpendingOut": {
        "properties": {
          "categories": {
            "items": {
              "$ref": "#/components/schemas/CategorySpendOut"
            },
            "title": "Categories",
            "type": "array"
          },
          "currency": {
            "title": "Currency",
            "type": "string"
          },
          "fees": {
            "$ref": "#/components/schemas/Money"
          },
          "money_out": {
            "$ref": "#/components/schemas/Money"
          },
          "month": {
            "title": "Month",
            "type": "string"
          },
          "refunds": {
            "$ref": "#/components/schemas/Money"
          },
          "total": {
            "$ref": "#/components/schemas/Money"
          },
          "unmatched_refunds": {
            "$ref": "#/components/schemas/Money"
          }
        },
        "required": [
          "month",
          "currency",
          "total",
          "categories",
          "unmatched_refunds",
          "refunds",
          "fees",
          "money_out"
