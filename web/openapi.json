        "title": "SpendingOut",
        "type": "object"
      },
      "SummaryOut": {
        "properties": {
          "currency": {
            "title": "Currency",
            "type": "string"
          },
          "gaps": {
            "items": {
              "$ref": "#/components/schemas/GapOut"
            },
            "title": "Gaps",
            "type": "array"
          },
          "money_in": {
            "$ref": "#/components/schemas/Money"
          },
          "money_out": {
            "$ref": "#/components/schemas/Money"
          },
          "month": {
            "title": "Month",
            "type": "string"
          },
          "net": {
            "$ref": "#/components/schemas/Money"
