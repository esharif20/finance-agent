            "type": "integer"
          },
          "kind": {
            "title": "Kind",
            "type": "string"
          },
          "ledger_balance": {
            "$ref": "#/components/schemas/Money"
          },
          "masked_number": {
            "title": "Masked Number",
            "type": "string"
          },
          "name": {
            "title": "Name",
            "type": "string"
          }
        },
        "required": [
          "id",
          "masked_number",
          "name",
          "kind",
          "currency",
          "bank_balance",
