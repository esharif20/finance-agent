        },
        "required": [
          "name",
          "amount"
        ],
        "title": "CategorySpendOut",
        "type": "object"
      },
      "GapOut": {
        "properties": {
          "amount": {
            "$ref": "#/components/schemas/Money"
          },
          "from_date": {
            "title": "From Date",
            "type": "string"
          },
          "to_date": {
            "title": "To Date",
            "type": "string"
          }
        },
        "required": [
          "from_date",
          "to_date",
          "amount"
        ],
        "title": "GapOut",
        "type": "object"
      },
