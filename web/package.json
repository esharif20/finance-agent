{
  "name": "finance-agent-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:demo": "tsc --noEmit && VITE_DEMO=1 vite build --outDir dist-demo",
    "test": "vitest run",
    "types": "openapi-typescript openapi.json -o src/api/schema.d.ts",
    "gen": "sh -c 'cd .. && uv run python scripts/export_openapi.py' > openapi.json && pnpm types",
    "smoke": "node e2e/smoke.mjs",
    "smoke:demo": "node smoke/demo.spec.ts"
  },
  "dependencies": {
    "@fontsource-variable/bricolage-grotesque": "5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "@fontsource-variable/red-hat-display": "^5.3.0",
    "@fontsource-variable/red-hat-text": "^5.3.0",
    "@gsap/react": "2.1.2",
    "@tailwindcss/vite": "^4.3.5",
    "@tanstack/react-query": "^5.107.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "gsap": "3.13.0",
    "lenis": "1.3.4",
    "lucide-react": "^1.70.0",
    "motion": "^14.10.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.5",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "~0.186.0",
    "@vitejs/plugin-react": "^6.2.1",
    "jsdom": "^31.0.0",
    "openapi-typescript": "^7.13.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  }
}
